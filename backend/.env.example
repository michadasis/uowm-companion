# The read-only Postgres role for the student restaurant menu, the database
# the restaurant-schedule-watcher fills. Either variable works; the pooled
# one is preferred. Only the menu endpoint reads it.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Set on Vercel so the cron endpoint (called every 10 minutes by cron-job.org)
# rejects anyone else. Any random string.
CRON_SECRET=

# Optional. When set, the document pipeline may fall back to an LLM for a
# schedule the deterministic parsers can't read. Left empty, that step is off.
LLM_API_KEY=
